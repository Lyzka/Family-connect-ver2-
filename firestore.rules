rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // 1. GLOBAL OPERATOR PRESENCE: /global_presence/{userId}
    // Readable by any authenticated operator so Phone A & Phone B see each other
    // online; writable strictly by the authenticated owner (userId == request.auth.uid).
    // =========================================================================
    function isValidGlobalPresence(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.callSign is string && data.callSign.size() >= 1 && data.callSign.size() <= 80 &&
             data.presence is string && (data.presence == 'ONLINE' || data.presence == 'OFFLINE' || data.presence == 'TYPING' || data.presence == 'BUSY') &&
             (!('statusMessage' in data) || data.statusMessage == null || (data.statusMessage is string && data.statusMessage.size() <= 240)) &&
             data.e2eeFingerprint is string && data.e2eeFingerprint.size() >= 8 && data.e2eeFingerprint.size() <= 256 &&
             (!('deviceModel' in data) || data.deviceModel == null || (data.deviceModel is string && data.deviceModel.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /global_presence/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'callSign', 'presence',
                         'e2eeFingerprint', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'callSign', 'presence',
                         'statusMessage', 'e2eeFingerprint', 'deviceModel',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidGlobalPresence(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidGlobalPresence(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'callSign', 'presence', 'statusMessage',
                         'e2eeFingerprint', 'deviceModel', 'createdAt', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // =========================================================================
    // 2. SHARED MULTI-DEVICE COMMS ROOMS: /global_comms_rooms/{roomId}
    // =========================================================================
    function isValidGlobalRoomMessage(data, roomId) {
      return data.roomId is string && data.roomId == roomId && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             (data.senderId == request.auth.uid || data.recipientId == request.auth.uid) &&
             data.senderLabel is string && data.senderLabel.size() >= 1 && data.senderLabel.size() <= 80 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 4000 &&
             data.messageType is string && (
               data.messageType == 'TEXT' ||
               data.messageType == 'VOICE_NOTE' ||
               data.messageType == 'IMAGE' ||
               data.messageType == 'FILE' ||
               data.messageType == 'CONTROL_SIGNAL' ||
               data.messageType == 'WEBRTC_OFFER' ||
               data.messageType == 'WEBRTC_ANSWER' ||
               data.messageType == 'WEBRTC_ICE'
             ) &&
             data.status is string && (data.status == 'SENT' || data.status == 'DELIVERED' || data.status == 'READ') &&
             data.isEncrypted is bool &&
             (!('mediaUri' in data) || data.mediaUri == null || (data.mediaUri is string && data.mediaUri.size() <= 1024)) &&
             (!('audioDurationMs' in data) || data.audioDurationMs == null || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 600000)) &&
             (!('cipherHex' in data) || data.cipherHex == null || (data.cipherHex is string && data.cipherHex.size() <= 16384)) &&
             (!('modelBadge' in data) || data.modelBadge == null || (data.modelBadge is string && data.modelBadge.size() <= 80)) &&
             (!('signalPayload' in data) || data.signalPayload == null || (data.signalPayload is string && data.signalPayload.size() <= 262144)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGlobalRtcSignal(data, roomId) {
      return data.roomId is string && data.roomId == roomId && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             (data.senderId == request.auth.uid || data.recipientId == request.auth.uid) &&
             data.callType is string && (data.callType == 'AUDIO' || data.callType == 'VIDEO') &&
             data.signalType is string && (
               data.signalType == 'RINGING' ||
               data.signalType == 'SDP_OFFER' ||
               data.signalType == 'SDP_ANSWER' ||
               data.signalType == 'ICE_CANDIDATE' ||
               data.signalType == 'CONNECTED' ||
               data.signalType == 'ENDED'
             ) &&
             data.sdpPayload is string && data.sdpPayload.size() <= 131072 &&
             data.iceCandidate is string && data.iceCandidate.size() <= 2048 &&
             data.iceCandidatesCount is int && data.iceCandidatesCount >= 0 && data.iceCandidatesCount <= 256 &&
             data.isEncrypted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /global_comms_rooms/{roomId} {
      // Subcollection 2A: Shared Messages & Control Signals
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(roomId);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'roomId', 'senderId', 'recipientId', 'senderLabel', 'text',
                           'messageType', 'status', 'isEncrypted', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderId', 'recipientId', 'senderLabel', 'text',
                           'messageType', 'status', 'isEncrypted', 'mediaUri',
                           'audioDurationMs', 'cipherHex', 'modelBadge', 'signalPayload',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidGlobalRoomMessage(incoming(), roomId);

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidGlobalRoomMessage(incoming(), roomId) &&
                         (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid) &&
                         incoming().roomId == existing().roomId &&
                         incoming().senderId == existing().senderId &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'text', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid);
      }

      // Subcollection 2B: Shared WebRTC Signaling (SDP Offer/Answer & ICE Candidates)
      match /rtc_signals/{signalId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(signalId);
        allow list: if isSignedIn() && isValidId(roomId);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(signalId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'roomId', 'senderId', 'recipientId', 'callType', 'signalType',
                           'sdpPayload', 'iceCandidate', 'iceCandidatesCount',
                           'isEncrypted', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderId', 'recipientId', 'callType', 'signalType',
                           'sdpPayload', 'iceCandidate', 'iceCandidatesCount',
                           'isEncrypted', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidGlobalRtcSignal(incoming(), roomId);

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(signalId) &&
                         isValidGlobalRtcSignal(incoming(), roomId) &&
                         (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid) &&
                         incoming().roomId == existing().roomId &&
                         incoming().senderId == existing().senderId &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'signalType', 'sdpPayload', 'iceCandidate',
                           'iceCandidatesCount', 'isEncrypted', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(signalId) &&
                         (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid);
      }
    }

    // =========================================================================
    // 3. USER-SCOPED ARCHIVE & AI FALLBACK: /users/{userId}/...
    // =========================================================================
    function isValidHoloMessage(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.peerId is string && data.peerId.size() >= 1 && data.peerId.size() <= 64 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderLabel is string && data.senderLabel.size() >= 1 && data.senderLabel.size() <= 80 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 4000 &&
             data.messageType is string && (data.messageType == 'TEXT' || data.messageType == 'VOICE_NOTE' || data.messageType == 'IMAGE' || data.messageType == 'FILE') &&
             data.status is string && (data.status == 'SENT' || data.status == 'DELIVERED' || data.status == 'READ') &&
             data.isFromMe is bool &&
             data.isEncrypted is bool &&
             (!('mediaUri' in data) || data.mediaUri == null || (data.mediaUri is string && data.mediaUri.size() <= 1024)) &&
             (!('audioDurationMs' in data) || data.audioDurationMs == null || (data.audioDurationMs is int && data.audioDurationMs >= 0 && data.audioDurationMs <= 600000)) &&
             (!('cipherHex' in data) || data.cipherHex == null || (data.cipherHex is string && data.cipherHex.size() <= 16384)) &&
             (!('modelBadge' in data) || data.modelBadge == null || (data.modelBadge is string && data.modelBadge.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHoloPeerPresence(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.peerId is string && data.peerId.size() >= 1 && data.peerId.size() <= 64 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.presence is string && (data.presence == 'ONLINE' || data.presence == 'OFFLINE' || data.presence == 'TYPING') &&
             data.unreadCount is int && data.unreadCount >= 0 && data.unreadCount <= 10000 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 500 &&
             data.isAiFallbackEnabled is bool &&
             data.e2eeFingerprint is string && data.e2eeFingerprint.size() >= 8 && data.e2eeFingerprint.size() <= 256 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidHoloRtcSession(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.peerId is string && data.peerId.size() >= 1 && data.peerId.size() <= 64 &&
             data.callType is string && (data.callType == 'AUDIO' || data.callType == 'VIDEO') &&
             data.callState is string && (data.callState == 'RINGING' || data.callState == 'OFFER' || data.callState == 'ANSWER' || data.callState == 'CONNECTED' || data.callState == 'ENDED') &&
             data.sdpOffer is string && data.sdpOffer.size() <= 8192 &&
             data.sdpAnswer is string && data.sdpAnswer.size() <= 8192 &&
             data.iceCandidatesCount is int && data.iceCandidatesCount >= 0 && data.iceCandidatesCount <= 256 &&
             data.latestIceCandidate is string && data.latestIceCandidate.size() <= 1024 &&
             data.isEncrypted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll([
                           'userId', 'peerId', 'senderId', 'senderLabel', 'text',
                           'messageType', 'status', 'isFromMe', 'isEncrypted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'peerId', 'senderId', 'senderLabel', 'text',
                           'messageType', 'status', 'isFromMe', 'isEncrypted',
                           'mediaUri', 'audioDurationMs', 'cipherHex', 'modelBadge',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidHoloMessage(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(messageId) &&
                         isValidHoloMessage(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().peerId == existing().peerId &&
                         incoming().senderId == existing().senderId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'text', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(messageId);
      }

      match /peers/{peerId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(peerId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(peerId) &&
                         incoming().peerId == peerId &&
                         incoming().keys().hasAll([
                           'userId', 'peerId', 'displayName', 'presence',
                           'unreadCount', 'lastMessagePreview', 'isAiFallbackEnabled',
                           'e2eeFingerprint', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'peerId', 'displayName', 'presence',
                           'unreadCount', 'lastMessagePreview', 'isAiFallbackEnabled',
                           'e2eeFingerprint', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidHoloPeerPresence(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(peerId) &&
                         isValidHoloPeerPresence(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().peerId == existing().peerId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'presence', 'unreadCount', 'lastMessagePreview',
                           'isAiFallbackEnabled', 'e2eeFingerprint', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(peerId);
      }

      match /rtc_sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll([
                           'userId', 'peerId', 'callType', 'callState',
                           'sdpOffer', 'sdpAnswer', 'iceCandidatesCount',
                           'latestIceCandidate', 'isEncrypted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'peerId', 'callType', 'callState',
                           'sdpOffer', 'sdpAnswer', 'iceCandidatesCount',
                           'latestIceCandidate', 'isEncrypted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidHoloRtcSession(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(sessionId) &&
                         isValidHoloRtcSession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().peerId == existing().peerId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'callState', 'sdpOffer', 'sdpAnswer',
                           'iceCandidatesCount', 'latestIceCandidate',
                           'isEncrypted', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
